# ==============================================================================
# CyberShield - AI Scam & Fraud Analyzer Environment Variables Example
# Copy this file to .env and configure your real secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (e.g. gemini-3.1-flash-lite, gemini-flash-latest)
GEMINI_MODEL=gemini-3.1-flash-lite

# Server Port (default: 8080)
PORT=8080

# Environment mode (development / production)
NODE_ENV=development

# Optional Rate Limiting (requests per minute per client IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
